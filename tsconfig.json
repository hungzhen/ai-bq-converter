{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],

    "strict": true,
    // "noUncheckedIndexedAccess" is deliberately NOT enabled: the exact, read-only copy of the
    // Cost Library's costLibrary.ts (src/vendor/cost-library) does not compile with it (line 624),
    // and that file must not be changed. The Cost Library itself compiles without it.
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,

    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests", "scripts", "vite.config.ts"]
}
